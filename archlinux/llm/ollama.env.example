# Optional Ollama container tunables for compose-managed archlinux stack.
# Copy to llm/ollama.env (pre-deploy auto-copies when missing), then set keys like:
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=1

# Preferred model (set by llm-manager agent or override here).
# qwen3:8b-q4_K_M is fast (~40-50 tok/s on RX 9070 XT), excellent tool calling, fits ~5GB Q4.
# Ollama will auto-pull this on first use if not already present.
# OLLAMA_DEFAULT_MODEL=qwen3:8b-q4_K_M
