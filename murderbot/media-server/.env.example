# murderbot/media-server — environment template
#
# Komodo's pre_deploy renders the real .env from this template plus secrets
# fetched from Bitwarden. Do not commit real values; .env is gitignored.

# ── Config volumes (/mnt/storage/media/config — pre-created by Ansible or mkdir -p)
CONFIG_BASE=/mnt/storage/media/config
PROFILARR_CONFIG=${CONFIG_BASE}/profilarr/config
RADARR_CONFIG=${CONFIG_BASE}/radarr/config
BAZARR_CONFIG=${CONFIG_BASE}/bazarr/config
SONARR_CONFIG=${CONFIG_BASE}/sonarr/config
RECYCLARR_CONFIG=${CONFIG_BASE}/recyclarr/config
PROWLARR_CONFIG=${CONFIG_BASE}/prowlarr/config
SABNZBD_CONFIG=${CONFIG_BASE}/sabnzbd/config
JELLYFIN_CONFIG=${CONFIG_BASE}/jellyfin/config
SEERR_CONFIG=${CONFIG_BASE}/seerr/config
CALIBRE_CONFIG=${CONFIG_BASE}/calibre/config
CALIBREWEB_CONFIG=${CONFIG_BASE}/calibre-web/config
LAZYLIBRARIAN_CONFIG=${CONFIG_BASE}/lazylibrarian/config
CALIBRE_CUSTOM_INIT=${CONFIG_BASE}/calibre/custom-cont-init.d
HARDCOVER_PROVIDER_FILE=${CONFIG_BASE}/calibre-web/hardcover-mod/hardcover.py
CALIBRE_SYNC_SCRIPTS=${CONFIG_BASE}/calibre/sync-scripts

# HARDCOVER_API_KEY=   # BWS: hardcover-api-key — free token from
                        # hardcover.app/account/api. One source of truth for
                        # book metadata (title/authors/series): calibre's
                        # Hardcover plugin + calibre-web's Hardcover provider
                        # + the calibre-metadata-sync sidecar all use this.

# ── Library volumes (/mnt/storage is mounted out of band)
DATA_BASE=/mnt/storage
MOVIES_FOLDER=${DATA_BASE}/movies
TV_FOLDER=${DATA_BASE}/tv
BOOKS_FOLDER=${DATA_BASE}/books
CALIBRE_LIBRARY_FOLDER=${BOOKS_FOLDER}/calibre-library
DISCOVER_FOLDER=${DATA_BASE}/discover
USENET_DOWNLOADS=${DATA_BASE}/downloads/complete
USENET_DOWNLOADS_INCOMPLETE=${DATA_BASE}/downloads/incomplete
TRANSCODE_FOLDER=${DATA_BASE}/cache/transcode

# ── Public URL used by Jellyfin metadata / generated links
JELLYFIN_URL=media.amer.dev
