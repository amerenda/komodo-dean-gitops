# murderbot/media-server — environment template
#
# Komodo's pre_deploy renders the real .env from this template plus secrets
# fetched from Bitwarden. Do not commit real values; .env is gitignored.

# ── Config volumes (/mnt/storage/media/config — pre-created by Ansible or mkdir -p)
CONFIG_BASE=/mnt/storage/media/config
# SQLite-backed services live on the NVMe SSD (/opt), not CONFIG_BASE (RAID5)
# — pre-deploy.sh sets the real *_CONFIG_ROOT values and creates these dirs;
# the values below are illustrative only. See pre-deploy.sh for why.
PROFILARR_CONFIG=/opt/profilarr-config
RADARR_CONFIG=/opt/radarr-config
BAZARR_CONFIG=/opt/bazarr-config
SONARR_CONFIG=/opt/sonarr-config
RECYCLARR_CONFIG=${CONFIG_BASE}/recyclarr/config
PROWLARR_CONFIG=/opt/prowlarr-config
SABNZBD_CONFIG=/opt/sabnzbd-config
JELLYFIN_CONFIG=/opt/jellyfin-config
SEERR_CONFIG=/opt/seerr-config
MAINTAINERR_CONFIG=/opt/maintainerr-config
# jellyfin-auto-collections has no embedded db (config.yaml + a small OAuth
# token file only) — stays on CONFIG_BASE (RAID5), like recyclarr/calibre.
JELLYFIN_AUTO_COLLECTIONS_CONFIG=${CONFIG_BASE}/jellyfin-auto-collections/config
JELLYFIN_AUTO_COLLECTIONS_CRONTAB=0 */6 * * *

# JELLYFIN_API_KEY=   # BWS: jellyfin-api-key — Admin > Dashboard > API Keys
# TRAKT_CLIENT_ID=     # BWS: jellyfin-trakt-client-id — personal Trakt app
# TRAKT_CLIENT_SECRET= # BWS: jellyfin-trakt-client-secret
#   jellyfin-auto-collections needs its own personal Trakt app (device-code
#   flow, no redirect reachability needed — use urn:ietf:wg:oauth:2.0:oob
#   as the app's Redirect URI). Unlike Radarr's own pre-registered Trakt
#   app, this one requires Trakt VIP to create (trakt.tv/oauth/applications/new).
CALIBRE_CONFIG=${CONFIG_BASE}/calibre/config
CALIBREWEB_CONFIG=/opt/calibre-web-config
CALIBRE_CUSTOM_INIT=${CONFIG_BASE}/calibre/custom-cont-init.d
HARDCOVER_PROVIDER_FILE=${CONFIG_BASE}/calibre-web/hardcover-mod/hardcover.py
CALIBRE_SYNC_SCRIPTS=${CONFIG_BASE}/calibre/sync-scripts
SHELFARR_CONFIG=/opt/shelfarr-config
BOOKORBIT_DATA_FOLDER=${CONFIG_BASE}/bookorbit/data
BOOKORBIT_POSTGRES_DATA=${CONFIG_BASE}/bookorbit/postgres

# HARDCOVER_API_KEY=   # BWS: hardcover-api-key — free token from
                        # hardcover.app/account/api. One source of truth for
                        # book metadata (title/authors/series): calibre's
                        # Hardcover plugin + calibre-web's Hardcover provider
                        # + the calibre-metadata-sync sidecar all use this.

# shelfarr + BookOrbit — LazyLibrarian→shelfarr migration, now production
# as of Phase 3 (Obsidian Projects/Media Server Stack/Plans/shelfarr-migration.md).
# SHELFARR_RAILS_MASTER_KEY=       # BWS: shelfarr-rails-master-key
# BOOKORBIT_JWT_SECRET=            # BWS: bookorbit-jwt-secret
# BOOKORBIT_SETUP_BOOTSTRAP_TOKEN= # BWS: bookorbit-setup-bootstrap-token
# BOOKORBIT_POSTGRES_PASSWORD=     # BWS: bookorbit-postgres-password
# BOOKORBIT_MIGRATION_ENCRYPTION_KEY= # BWS: bookorbit-migration-encryption-key
BOOKORBIT_MIGRATION_IMPORTS_FOLDER=${CONFIG_BASE}/bookorbit/imports
BOOKORBIT_APP_URL=https://bookorbit.media.amer.dev

# ── Library volumes (/mnt/storage is mounted out of band)
DATA_BASE=/mnt/storage
MOVIES_FOLDER=${DATA_BASE}/movies
TV_FOLDER=${DATA_BASE}/tv
BOOKS_FOLDER=${DATA_BASE}/books
CALIBRE_LIBRARY_FOLDER=${BOOKS_FOLDER}/calibre-library
# Production shelfarr/BookOrbit library as of Phase 3 of the shelfarr
# migration (renamed from BOOKS_TRIAL_* — no "trial"-named path stays
# live). Deliberately separate from CALIBRE_LIBRARY_FOLDER above — the old
# calibre library is imported in via BookOrbit's Migration UI, then
# retired in Phase 4, not merged on disk.
BOOKS_LIBRARY_ROOT=${BOOKS_FOLDER}/library
BOOKS_LIBRARY_EBOOKS_FOLDER=${BOOKS_LIBRARY_ROOT}/ebooks
BOOKS_LIBRARY_AUDIOBOOKS_FOLDER=${BOOKS_LIBRARY_ROOT}/audiobooks
BOOKS_LIBRARY_COMICS_FOLDER=${BOOKS_LIBRARY_ROOT}/comics
DISCOVER_FOLDER=${DATA_BASE}/discover
USENET_DOWNLOADS=${DATA_BASE}/downloads/complete
USENET_DOWNLOADS_INCOMPLETE=${DATA_BASE}/downloads/incomplete
TRANSCODE_FOLDER=${DATA_BASE}/cache/transcode

# ── Public URL used by Jellyfin metadata / generated links
JELLYFIN_URL=media.amer.dev
