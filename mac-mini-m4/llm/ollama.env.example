# Optional Ollama container tunables for compose-managed Mac Mini stack.
# pre-deploy copies this to llm/ollama.env when missing. The agent/UI can rewrite ollama.env.
#
# Always-on serving config — single model loaded at a time for max speed and lowest latency.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Flash attention gives ~20-30% speedup on Apple Silicon M-series GPUs.
OLLAMA_FLASH_ATTENTION=1

# Preferred model (set by llm-manager agent or override here).
# qwen2.5:7b-instruct is fast (~30-40 tok/s on M4), excellent tool calling, fits ~5GB Q4.
# Ollama will auto-pull this on first use if not already present.
OLLAMA_DEFAULT_MODEL=qwen2.5:7b-instruct-q4_K_M
