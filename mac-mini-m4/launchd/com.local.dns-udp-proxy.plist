<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.dns-udp-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/alex/komodo-dean-gitops/mac-mini-m4/scripts/dns-udp-proxy.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Pin backend socket to loopback so Tailscale utun route changes on the
         Mac Mini host don't cause the proxy to pick a stale source IP and drop
         packets. OrbStack's port 5354 forwarder is always on 127.0.0.1. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DNS_PROXY_BACKEND_SRC</key>
        <string>127.0.0.1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/dns-udp-proxy.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/dns-udp-proxy.log</string>
</dict>
</plist>
