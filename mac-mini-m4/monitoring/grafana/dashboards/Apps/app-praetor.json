        {
          "expr": "rate(container_network_transmit_bytes_total{namespace=\"praetor\", pod=~\"praetor-coder-worker.*\"}[5m])",
          "legendFormat": "TX"
        }
      ]
    },
    {
      "id": 104,
      "title": "Coder — Task Invocations",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "rate(praetor_task_invocations_total{agent=\"coder\", status=\"success\"}[5m])",
          "legendFormat": "Success/s"
        },
        {
          "expr": "rate(praetor_task_invocations_total{agent=\"coder\", status=\"error\"}[5m])",
          "legendFormat": "Error/s"
        }
      ]
    },
    {
      "id": 105,
      "title": "Coder — Task Duration",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(praetor_task_duration_seconds_bucket{agent=\"coder\"}[10m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(praetor_task_duration_seconds_bucket{agent=\"coder\"}[10m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 106,
      "title": "Coder — Pod Restarts",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 0, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "max(kube_pod_container_status_restarts_total{namespace=\"praetor\", container=\"coder-worker\"})",
          "legendFormat": "Restarts"
        }
      ]
    },
    {
      "id": 107,
      "title": "Coder — Active Tasks",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 4, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "praetor_task_active{agent=\"coder\"} or vector(0)",
          "legendFormat": "Active"
        }
      ]
    },

