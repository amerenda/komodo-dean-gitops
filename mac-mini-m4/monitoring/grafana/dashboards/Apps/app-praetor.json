    {
      "id": 103,
      "title": "Coder — Network I/O",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 29 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{namespace=\"praetor\", pod=~\"praetor-coder-worker.*\"}[5m])",
          "legendFormat": "RX"
