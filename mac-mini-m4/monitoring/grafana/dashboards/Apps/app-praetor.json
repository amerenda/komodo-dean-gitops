          "expr": "container_memory_working_set_bytes{namespace=\"praetor\", container=\"coder-worker\"}",
          "legendFormat": "Used"
        },
        {
          "expr": "kube_pod_container_resource_limits{namespace=\"praetor\", resource=\"memory\", container=\"coder-worker\"}",
