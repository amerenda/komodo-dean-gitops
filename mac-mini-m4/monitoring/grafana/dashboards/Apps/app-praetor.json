{
  "title": "Praetor — AI Agent Platform",
  "uid": "praetor-platform",
  "tags": ["app", "praetor", "ai-agents"],
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Pods Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "green", "value": 8 }
            ]
          },
          "mappings": []
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"praetor\", phase=\"Running\"})",
          "legendFormat": "Running"
        }
      ]
    },
    {
      "id": 2,
      "title": "OOM Kills (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"praetor\", container=\"coder-worker\"}[24h]))",
          "legendFormat": "Coder Restarts"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Tasks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(praetor_task_active) or vector(0)",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "id": 4,
      "title": "Coder Memory Usage",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "red", "value": 0.85 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"praetor\", container=\"coder-worker\"} / on(container) kube_pod_container_resource_limits{namespace=\"praetor\", resource=\"memory\", container=\"coder-worker\"}",
          "legendFormat": "Coder"
        }
      ]
    },
    {
      "id": 5,
      "title": "Task Success Rate (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(increase(praetor_task_invocations_total{status=\"success\"}[1h])) / (sum(increase(praetor_task_invocations_total[1h])) > 0) or vector(1)",
          "legendFormat": "Success Rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Total Tasks Completed (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "expr": "sum(increase(praetor_task_invocations_total[1h])) or vector(0)",
          "legendFormat": "Tasks"
        }
      ]
    },

    {
      "id": 7,
      "title": "Agent Status Overview",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Memory Used" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "Mem %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.6 },
                    { "color": "red", "value": 0.85 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Restarts" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 5 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-text" }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "Container", "desc": false }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "container": "Container",
              "Value #A": "Memory Used",
              "Value #B": "Mem %",
              "Value #C": "CPU (cores)",
              "Value #D": "Restarts"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"praetor\", container!=\"\", container!=\"POD\"}",
          "legendFormat": "{{container}}",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "container_memory_working_set_bytes{namespace=\"praetor\", container!=\"\", container!=\"POD\"} / on(container) group_left() kube_pod_container_resource_limits{namespace=\"praetor\", resource=\"memory\", container!=\"\"}",
          "legendFormat": "{{container}}",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"praetor\", container!=\"\", container!=\"POD\"}[5m])",
          "legendFormat": "{{container}}",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"praetor\", container!=\"\"}",
          "legendFormat": "{{container}}",
          "instant": true,
          "refId": "D"
        }
      ]
    },

    {
      "id": 8,
      "title": "All Agents — Memory Usage vs Limit",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "limit" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"praetor\", container!=\"\", container!=\"POD\"}",
          "legendFormat": "{{container}}",
          "refId": "usage"
        },
        {
          "expr": "kube_pod_container_resource_limits{namespace=\"praetor\", resource=\"memory\", container!=\"\"}",
          "legendFormat": "limit: {{container}}",
          "refId": "limit"
        }
      ]
    },

    {
      "id": 9,
      "title": "All Agents — CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "axisLabel": "cores" },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"praetor\", container!=\"\", container!=\"POD\"}[5m])",
          "legendFormat": "{{container}}"
        }
      ]
    },

    { "id": 100, "title": "Coder Agent", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 }, "collapsed": false },

